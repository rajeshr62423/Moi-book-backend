# 3000 is taken by the Next.js frontend dev server — this API listens on 4000.
PORT=4000
CORS_ORIGIN=http://localhost:3000

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/moibook

# JWT — generate real random values, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary — used to store uploaded images (event thumbnails, profile
# photos, etc). Get these from the Cloudinary console's API Keys page.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Unused for now — only needed if auth/guest/event/moi get split into real microservices.
AUTH_SERVICE_URL=http://auth-service:3001
GUEST_SERVICE_URL=http://guest-service:3002
EVENT_SERVICE_URL=http://event-service:3003
MOI_SERVICE_URL=http://moi-service:3004
